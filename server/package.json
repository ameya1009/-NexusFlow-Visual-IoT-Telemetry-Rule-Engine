{
  "name": "nexusflow-server",
  "version": "1.0.0",
  "description": "NexusFlow Backend - High-speed IoT telemetry ingestion and reactive rule engine",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 test/**/*.test.js",
    "mock-sensor": "node src/ingestion/scripts/mockSensor.js",
    "verify-demo": "node src/ingestion/scripts/verifyIngestionDemo.js",
    "audit": "node src/ingestion/scripts/ingestionAudit.js",
    "load-test": "node src/ingestion/scripts/loadTest.js",
    "storage-audit": "node src/ingestion/scripts/storageAudit.js",
    "mid-demo": "node src/ingestion/scripts/midProjectDemo.js"
  },
  "keywords": [
    "iot",
    "telemetry",
    "timeseries",
    "mongodb",
    "express",
    "rxjs",
    "rule-engine"
  ],
  "author": "NexusFlow Team",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.4"
  }
}
